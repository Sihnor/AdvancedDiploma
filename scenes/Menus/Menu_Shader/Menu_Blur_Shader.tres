[resource]
code = "shader_type canvas_item;
render_mode blend_disabled;

uniform float BlurAmount : hint_range(0, 5, 0.10000000149012);
uniform sampler2D Texture2DParameter : repeat_enable, hint_screen_texture;
uniform vec4 MixColor : source_color;
uniform float MixAmount : hint_range(0, 1);



void fragment() {
// Input:5
	vec2 n_out5p0 = SCREEN_UV;


// FloatParameter:2
	float n_out2p0 = BlurAmount;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = textureLod(Texture2DParameter, n_out5p0, n_out2p0);


// ColorParameter:6
	vec4 n_out6p0 = MixColor;


// FloatParameter:7
	float n_out7p0 = MixAmount;


// Mix:8
	vec3 n_out8p0 = mix(vec3(n_out3p0.xyz), vec3(n_out6p0.xyz), vec3(n_out7p0));


// Output:0
	COLOR.rgb = n_out8p0;


}
